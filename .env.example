# PostgreSQL connection string
DATABASE_URL=postgresql://tendy:tendy@localhost:5432/tendy

# JWT secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-random-secret

# CORS — comma-separated origins (default: * allows all)
# CORS_ORIGINS=http://localhost:3001,https://tendy.app

# Base URL — used for OAuth metadata discovery (required for connectors)
# Set this to your public-facing URL in production (e.g., https://api.tendy.app)
# BASE_URL=https://api.tendy.app
